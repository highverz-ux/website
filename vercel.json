{
  "cleanUrls": true,
  "framework": "vite",
  "headers": [
    {
      "source": "/assets/(.*)\\.(mp4|webm|mov|jpg|jpeg|png|webp|avif|svg|woff2?)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
